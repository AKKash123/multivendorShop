generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LedgerType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  COD_COLLECTION
  ADJUSTMENT
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String?  @unique
  name        String
  email       String   @unique
  phone       String?
  role        UserRole @default(CUSTOMER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor    Vendor?
  orders    Order[]        @relation("CustomerOrders")
  addresses SavedAddress[]
  auditLogs AuditLog[]     @relation("AuditActor")
}

model Vendor {
  id            String       @id @default(cuid())
  userId        String       @unique
  storeName     String
  slug          String       @unique
  description   String?
  status        VendorStatus @default(PENDING)
  commissionBps Int          @default(1000)
  gstNumber     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  products      Product[]
  orderItems    OrderItem[]
  ledgerEntries VendorLedgerEntry[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  vendorId    String
  categoryId  String?
  name        String
  slug        String        @unique
  description String
  sku         String?
  pricePaise  Int
  stock       Int           @default(0)
  imageUrl    String?
  status      ProductStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([vendorId, status])
  @@index([categoryId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  subtotalPaise Int
  shippingPaise Int           @default(0)
  totalPaise    Int
  addressName   String
  addressLine   String
  city          String
  postalCode    String
  latitude      Float?
  longitude     Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer User        @relation("CustomerOrders", fields: [customerId], references: [id])
  items    OrderItem[]
  payment  Payment?
  refunds  Refund[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  productId             String
  vendorId              String
  productNameSnapshot   String
  unitPricePaise        Int
  quantity              Int
  commissionBpsSnapshot Int
  commissionPaise       Int
  vendorPayablePaise    Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([vendorId, orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]
}

model PaymentEvent {
  id              String    @id @default(cuid())
  paymentId       String
  providerEventId String?   @unique
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
}

model VendorLedgerEntry {
  id          String     @id @default(cuid())
  vendorId    String
  orderId     String?
  type        LedgerType
  amountPaise Int
  description String
  createdAt   DateTime   @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, createdAt])
  @@index([orderId])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  providerRefundId String?      @unique
  amountPaise      Int
  reason           String?
  status           RefundStatus @default(REQUESTED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model SavedAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String
  addressLine String
  city        String
  postalCode  String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
